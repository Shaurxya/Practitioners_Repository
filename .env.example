# =============================================================================
# The one environment file. Copy to .env and fill in real values.
#
#   cp .env.example .env
#
# Three consumers read this single file:
#
#   docker-compose.yml   Compose auto-loads .env from this directory and
#                        interpolates ${POSTGRES_*} into the postgres service.
#   Spring Boot          application.yml imports it via spring.config.import,
#                        so DB_* resolve without exporting anything by hand.
#   Vite                 vite.config.ts sets envDir to this directory, so the
#                        frontend reads VITE_* from here instead of its own file.
#
# -----------------------------------------------------------------------------
# READ THIS BEFORE ADDING A VARIABLE
#
# Vite inlines every variable whose name starts with VITE_ into the JavaScript
# bundle that ships to browsers. That bundle is public. Since the frontend now
# reads the same file as the database password, the VITE_ prefix is the only
# boundary between a server side secret and a published one.
#
#   NEVER put a secret behind a VITE_ name. Not a password, not an API key,
#   not a token. If the browser needs it, it is not a secret.
#
# Everything without the prefix stays server side and is never bundled.
# -----------------------------------------------------------------------------
#
# .env is gitignored and must stay that way. This .example file is the
# committed contract: it lists every key with placeholder values, so a new
# machine knows what to supply. In production nothing reads a file at all, the
# platform injects real environment variables, and real environment variables
# outrank anything imported here.
# =============================================================================


# -----------------------------------------------------------------------------
# Postgres, as created by docker-compose.yml
#
# The image reads these on FIRST START ONLY, when it initialises an empty data
# directory. Changing them later does nothing until `docker compose down -v`.
# -----------------------------------------------------------------------------
POSTGRES_DB=verification
POSTGRES_USER=verification
POSTGRES_PASSWORD=change-me

# Host side port. 5433 on purpose: a Postgres already installed on this machine
# owns 5432, and localhost:5432 would silently resolve to that one instead.
POSTGRES_PORT=5433


# -----------------------------------------------------------------------------
# Backend datasource
#
# Must agree with the Postgres block above when pointing at the local container.
# -----------------------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5433/verification
DB_USERNAME=verification
DB_PASSWORD=change-me


# -----------------------------------------------------------------------------
# Hosted Postgres, if you point at one instead of the container
#
# Supabase's direct host, db.<ref>.supabase.co, publishes an AAAA record and no
# A record. It is reachable over IPv6 only, unless the project buys the IPv4
# add-on, and a machine without an IPv6 route to it fails at the socket with
# java.net.NoRouteToHostException before any credential is even sent.
#
# Use the Supavisor pooler, which is IPv4, and note that the username carries
# the project ref:
#
#   DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres
#   DB_USERNAME=postgres.<project-ref>
#   DB_PASSWORD=<password>
# -----------------------------------------------------------------------------


# -----------------------------------------------------------------------------
# Backend runtime
# -----------------------------------------------------------------------------
SERVER_PORT=8080

# Profiles compose. "local" turns on SQL logging and health detail. Add "import"
# to run the CSV registry ingestion once at startup, which is otherwise never
# constructed:  SPRING_PROFILES_ACTIVE=local,import
SPRING_PROFILES_ACTIVE=local

# Registry CSV the ingestion profile reads. Relative to backend/.
APP_INGEST_FILE=../data/registry_synthetic.csv
APP_INGEST_BATCH_SIZE=500


# -----------------------------------------------------------------------------
# Frontend. Public, bundled, not secret. See the warning at the top.
# -----------------------------------------------------------------------------

# Empty in development: vite.config.ts proxies /api to localhost:8080, so there
# is no CORS to get wrong. Set to the API origin in a deployed build.
VITE_API_BASE_URL=

# "true" runs the app against the MSW mock API in src/mocks instead of the real
# backend. Also guarded by import.meta.env.DEV, so it cannot affect a production
# build. Delete this and src/mocks once the Spring endpoints exist.
VITE_USE_MOCKS=true

# "true" drops the registry import handlers from the mock worker, so those calls
# reach Spring: real PDF scanning through PaddleOCR, rows written to Postgres,
# and an upload that survives a page reload. Needs the backend and the extraction
# sidecar running. Everything else stays mocked.
VITE_REAL_IMPORTS=false

# "true" sends claim submission, the review queue and the public verify endpoint
# to Spring: matching runs against registry_records in Postgres, a clean match is
# approved and issued an Immortal ID instantly, and anything else lands in the
# Review tab for a person. Needs the backend running.
VITE_REAL_VERIFY=false
