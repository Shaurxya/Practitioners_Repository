# Keeps whitespace consistent across IntelliJ, VS Code, and everyone's editor.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Java convention is 4 spaces, and IntelliJ formats to it by default anyway.
[*.java]
indent_size = 4
max_line_length = 120

[*.{xml,yml,yaml,json,ts,tsx,js,jsx,css,html}]
indent_size = 2

[*.md]
# Trailing double space is a hard line break in Markdown.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
