<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    PARENT
    Spring Boot's starter-parent pins compatible versions for several hundred
    libraries. That is why almost no <dependency> below needs a <version>.
    Think of it as a lockfile you inherit instead of writing.
  -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <!-- COORDINATES. groupId:artifactId:version identifies this jar, the way
       name + version identify a package in package.json or pyproject.toml. -->
  <groupId>com.herbimmortal</groupId>
  <artifactId>verification-service</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <name>verification-service</name>
  <description>Practitioner verification backend for HerbImmortal</description>

  <properties>
    <!-- The starter-parent turns this into the compiler's release flag. -->
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>

    <!-- Spring MVC plus an embedded Tomcat. This is what makes the app a web
         server at all. Equivalent to FastAPI + uvicorn, or express. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- Hibernate (the ORM) plus Spring Data JPA (generated repositories) plus
         HikariCP (the connection pool). Roughly SQLAlchemy + its engine.
         Also what gives Actuator its database health check. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>

    <!-- Jakarta Bean Validation: @NotBlank, @Email, @Size on request objects,
         checked automatically when a controller parameter is @Valid.
         This is Pydantic's job. Nothing uses it yet, it is here because it is
         on your required list. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- Production endpoints under /actuator: health, info, metrics.
         No Python or Node equivalent ships by default, you normally hand write
         a /health route. Here you get it, including a real database probe. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- Versioned SQL migrations. Alembic's job, or Prisma Migrate's.
         Spring Boot detects it on the classpath and runs pending migrations
         automatically at startup, before Hibernate looks at the schema. -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <!-- Since Flyway 10 the database specific support is a separate module.
         Without this one you get "Unsupported Database: PostgreSQL 16" at boot. -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>

    <!-- The JDBC driver. runtime scope means it is not on the compile
         classpath, so no code can accidentally import a Postgres specific
         class, but it is present when the app actually runs. -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- RFC 4180 CSV parsing for registry ingestion. Hand rolling this is a
         mistake: quoted fields containing commas and embedded newlines are the
         cases that break naive splitters, and registry exports have both. -->
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-csv</artifactId>
      <version>1.14.1</version>
    </dependency>

    <!-- S3 CLIENT, for identity documents in MinIO.
         The AWS SDK v2 rather than the MinIO client, because MinIO speaks the
         S3 API and this is the one dependency that also works unchanged against
         real S3 in production: the difference is an endpoint, not a library.
         apache-client is pulled explicitly so the SDK does not fall back to the
         Netty async client, which drags in a whole event loop for what is a
         handful of small synchronous puts. -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>s3</artifactId>
      <version>2.49.6</version>
      <exclusions>
        <exclusion>
          <groupId>software.amazon.awssdk</groupId>
          <artifactId>netty-nio-client</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <!-- SPRING SECURITY.
         Brings the servlet filter chain, the authentication objects, and
         BCryptPasswordEncoder. Adding it changes the default posture of the
         whole application: every endpoint is denied until SecurityConfig says
         otherwise. That default is the point. The FastAPI equivalent would be
         a dependency applied to the whole router rather than per route. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>

    <!-- JJWT. Signs and verifies the access token.
         Split across three artifacts on purpose by its authors: only the api
         jar is compiled against, so application code cannot accidentally
         depend on implementation internals. impl and jackson are runtime. -->
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-api</artifactId>
      <version>0.12.6</version>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-impl</artifactId>
      <version>0.12.6</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-jackson</artifactId>
      <version>0.12.6</version>
      <scope>runtime</scope>
    </dependency>

    <!-- NO CACHE LIBRARY, DELIBERATELY.
         Two things here want caching: the API key lookup, so a request
         authenticated by a key does not hit Postgres every call, and the login
         attempt counter. Both are a bounded map with a TTL and nothing else,
         which is util/TtlCache: about forty lines, no eviction policy worth
         arguing about, and no transitive dependencies. Reach for Caffeine when
         something here needs a real eviction policy or hit statistics. -->

    <!-- JUnit 5, AssertJ, Mockito, and Spring's test support in one dependency.
         test scope keeps all of it out of the shipped jar. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- MockMvc helpers that understand authentication: with(user(...)),
         csrf(), and the assertions for an unauthenticated response. -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>

  </dependencies>

  <build>
    <plugins>
      <!-- Adds the `spring-boot:run` goal and builds an executable fat jar
           containing the app, its dependencies, and the embedded Tomcat. -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

</project>
