# Copy to .env.local. Vite only exposes variables prefixed with VITE_ to the
# browser bundle, so never put a secret in one of these.

# Leave empty in development: vite.config.ts proxies /api to localhost:8080.
VITE_API_BASE_URL=

# "true" runs the app against the MSW mock API in src/mocks instead of the real
# backend, so the portal and the console are usable before the Spring endpoints
# exist. Guarded by import.meta.env.DEV as well, so it cannot affect a
# production build. Delete this and src/mocks once the API is real.
VITE_USE_MOCKS=true
